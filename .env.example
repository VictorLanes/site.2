# String de conexão do Postgres (Neon). Na Vercel, a integração com o Neon preenche isso sozinha.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave para assinar as sessões. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Usado apenas pelo "npm run db:setup" para criar o primeiro administrador
ADMIN_NOME="Administrador Geral"
ADMIN_EMAIL="seu.email@empresa.com.br"
ADMIN_PASSWORD="uma-senha-forte"
